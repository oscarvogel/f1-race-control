# --- Race Center -------------------------------------------------------------
# Copiar a .env y ajustar. El .env NUNCA se sube a Git.

APP_NAME=Race Center
APP_MODE=personal
APP_TIMEZONE=America/Argentina/Cordoba
APP_DEBUG=true

# --- Seleccion de proveedor --------------------------------------------------
# auto | live | historical | metadata
DATA_PROVIDER=auto
LIVE_PROVIDER=free_livetiming
HISTORICAL_PROVIDER=openf1
METADATA_PROVIDER=jolpica

# --- Proveedor live (servicio Node local) ------------------------------------
F1_LIVETIMING_URL=http://127.0.0.1:3000

# --- OpenF1 (historico gratuito desde 2023) ----------------------------------
OPENF1_BASE_URL=https://api.openf1.org/v1
# El acceso live de OpenF1 requiere suscripcion pagada: queda desactivado.
OPENF1_LIVE_ENABLED=false
# Clave propia para acceso live autorizado (opcional, no se versiona).
OPENF1_API_KEY=

# --- Jolpica (calendario y metadatos) ----------------------------------------
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# --- Red ---------------------------------------------------------------------
ENABLE_PUBLIC_ACCESS=false
ENABLE_LAN_ACCESS=false
# Hosts de la LAN permitidos cuando ENABLE_LAN_ACCESS=true (separados por coma).
LAN_ALLOWED_HOSTS=
LAN_ALLOWED_ORIGINS=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5174

# --- Datos -------------------------------------------------------------------
# Los datos sinteticos estan desactivados: el dashboard real nunca los muestra.
ENABLE_MOCK_DATA=false

# --- Ingesta y frescura ------------------------------------------------------
INGEST_POLL_SECONDS=3
INGEST_HTTP_TIMEOUT=10
LIVE_MAX_AGE_SECONDS=90
DELAYED_MAX_AGE_SECONDS=300

# --- Base de datos -----------------------------------------------------------
DATABASE_ENGINE=sqlite
# Ruta del archivo SQLite. En el contenedor va en el volumen persistente:
# DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_DB_PATH=

# --- Django ------------------------------------------------------------------
# En un entorno personal local puede dejarse el valor por defecto.
DJANGO_SECRET_KEY=

# --- Despliegue en contenedor (Coolify) --------------------------------------
# Si estan vacios, el sitio se sirve SIN proteccion con usuario.
RACE_CENTER_USER=
RACE_CENTER_PASSWORD=
# Detras de un proxy inverso que termina TLS (Coolify): Django necesita
# saber que la peticion original era https.
TRUST_PROXY_SSL=false
