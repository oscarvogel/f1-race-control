# Sitio de Race Center.
#
# El entrypoint sustituye ${RACE_CENTER_AUTH} por las directivas de proteccion
# con usuario, o por nada si no hay credenciales configuradas. envsubst solo
# sustituye esa variable: las demas ($host, $uri...) las resuelve nginx.

server {
    listen 80 default_server;
    server_name _;

    root /app/frontend/dist;
    index index.html;

    ${RACE_CENTER_AUTH}

    # El health check del orquestador (Coolify) no lleva credenciales: esta
    # ruta exacta responde sin proteccion. Solo dice si la app vive, sin
    # contarle nada a quien la consulta.
    location = /api/ping/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API interna: Django corre en loopback dentro del contenedor.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # La API no hace streaming, pero el snapshot historico puede tardar
        # varios segundos la primera vez (descarga de OpenF1).
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # SPA: cualquier ruta desconocida devuelve index.html (enrutado del lado
    # del cliente).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Los assets del build llevan hash en el nombre: se cachean para siempre.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # El index.html NO se cachea: es el que apunta a los assets con hash.
    location = /index.html {
        add_header Cache-Control "no-store";
    }
}
