services/live-timing/node_modules/

# Proveedor live vendorizado (services/live-timing es un clon de
# julesr0y/f1-livetiming-api). Se versiona como codigo normal, sin su .git,
# para conservar los parches locales de bind/CORS y la ruta car-data.
# El clon original queda renombrado como .git-upstream-backup/ para poder
# sincronizar con el upstream; no se versiona.
services/live-timing/.git/
services/live-timing/.git-upstream-backup/

